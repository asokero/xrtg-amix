+     *
+     * source() is a no-op when no setup program has been configured, so this
+     * remains safe for displays that do not use an Xsetup hook.
      */
-    if (!d->grabServer)
-	SetupDisplay (d);
+    SetupDisplay (d);
+    dpy = InitGreet (d);
     if (!dpy) {
 	LogError ("Cannot reopen display %s for greet window\n", d->name);
 	exit (RESERVER_DISPLAY);
