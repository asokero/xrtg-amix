+/* Footer text is independent of PROMPT_W and the authentication state.
+ * Keep the failure-message row free, even while no failure is displayed. */
+static int
+HintWidth (w, text)
+    LoginWidget w;
+    char *text;
+{
+    return text ? XTextWidth (w->login.promptFont, text, strlen (text)) : 0;
+}
+
+static void
+DrawHint (w, text, row)
+    LoginWidget w;
+    char *text;
+    int row;
+{
+    if (text && text[0])
+        XDrawString (XtDisplay (w), XtWindow (w), w->login.promptGC,
+            (int)(w->core.width - HintWidth (w, text)) / 2,
+            FAIL_Y(w) + (row + 2) * Y_INC(w), text, strlen (text));
+}
