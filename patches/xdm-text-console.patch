 /*ARGSUSED*/
 static void
+ConsoleTimeout (closure, id)
+    XtPointer closure;
+    XtIntervalId *id;
+{
+    LoginWidget w = (LoginWidget)closure;
+    int result, status;
+    result = waitpid(w->login.consolePid, &status, WNOHANG);
+    if (result == 0 || (result < 0 && errno == EINTR)) {
+        w->login.consoleTimeout = XtAddTimeOut(1000, ConsoleTimeout, closure);
+        return;
+    }
+    w->login.consoleTimeout = 0;
+    w->login.consolePid = 0;
+    w->login.consoleState = 3;
+    draw_it(w);
+}
+
+/* No configurable command or user arguments cross this privilege boundary.
+ * The detached child does not use Xlib or retain the X connection. */
+static int
+StartConsoleHelper ()
+{
+    struct stat st;
+    int pid, fd;
+    long maxfd;
+    char *env[3];
+    if (geteuid() != 0 ||
+        stat("/usr/X/bin/xdm-console", &st) != 0 ||
+        !S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 022))
+        return 0;
+    maxfd = sysconf(_SC_OPEN_MAX);
+    if (maxfd < 0) return 0;
+    pid = fork();
+    if (pid < 0) return 0;
+    if (pid != 0) return pid;
+    if (setsid() < 0) _exit(1);
+    signal(SIGHUP, SIG_IGN);
+    signal(SIGTERM, SIG_DFL);
+    signal(SIGINT, SIG_DFL);
+    signal(SIGCHLD, SIG_DFL);
+    for (fd = 0; fd < maxfd; fd++) close(fd);
+    if (chdir("/") != 0) _exit(1);
+    umask(077);
+    if (open("/dev/null", O_RDONLY) != 0) _exit(1);
+    if (open("/usr/X/lib/xdm/console.log",
+             O_WRONLY | O_CREAT | O_APPEND, 0600) != 1) _exit(1);
+    if (dup(1) != 2) _exit(1);
+    env[0] = "PATH=/usr/X/bin:/usr/bin:/usr/sbin:/usr/ucb:/bin";
+    env[1] = "HOME=/root";
+    env[2] = 0;
+    execle("/bin/sh", "sh", "/usr/X/bin/xdm-console", (char *)0, env);
+    _exit(1);
+    return 0;
+}
+
+static void
+ConsoleRequest (ctxw, event, params, num_params)
+    Widget ctxw;
+    XEvent *event;
+    String *params;
+    Cardinal *num_params;
+{
+    LoginWidget w = (LoginWidget)ctxw;
+    if (!w->login.allowTextConsole || w->login.consoleState) return;
+    RemoveFail(w);
+    bzero(w->login.data.name, NAME_LEN);
+    bzero(w->login.data.passwd, NAME_LEN);
+    w->login.cursor = 0;
+    w->login.state = GET_NAME;
+    if (w->login.sessionArg) XtFree(w->login.sessionArg);
+    w->login.sessionArg = 0;
+    w->login.consoleState = 1;
+    draw_it(w);
+}
+
+static void
+ConsoleConfirm (ctxw, event, params, num_params)
+    Widget ctxw;
+    XEvent *event;
+    String *params;
+    Cardinal *num_params;
+{
+    LoginWidget w = (LoginWidget)ctxw;
+    if (!w->login.allowTextConsole || w->login.consoleState != 1) return;
+    w->login.consoleState = 2;
+    draw_it(w);
+    XFlush(XtDisplay(w));
+    w->login.consolePid = StartConsoleHelper();
+    if (!w->login.consolePid) {
+        w->login.consoleState = 3;
+        draw_it(w);
+        return;
+    }
+    w->login.consoleTimeout = XtAddTimeOut(1000, ConsoleTimeout, (XtPointer)w);
+}
+
+static void
+ConsoleCancel (ctxw, event, params, num_params)
+    Widget ctxw;
+    XEvent *event;
+    String *params;
+    Cardinal *num_params;
+{
+    LoginWidget w = (LoginWidget)ctxw;
+    if (w->login.consoleState != 1 && w->login.consoleState != 3) return;
+    w->login.consoleState = 0;
+    XClearWindow(XtDisplay(w), XtWindow(w));
+    draw_it(w);
+}
