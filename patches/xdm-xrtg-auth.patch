+#ifndef HASXDMAUTH
+
+/*
+ * The AMIX libc rand() used by the stock X11R5 fallback returns -1 on this
+ * system, producing an all-ff MIT-MAGIC-COOKIE-1 on every start.  Use a
+ * private, persistent 256-bit seed and SHA-256 instead.  The seed is local
+ * machine state, mode 0600, and is advanced atomically for every cookie.
+ *
+ * SHA-256 is implemented here to keep the patched xdm self-contained on the
+ * original AMIX toolchain.  unsigned long is 32 bits on m68k AMIX.
+ */
+#define XRTG_AUTH_MARKER "XRTG_SECURE_COOKIE_V1"
+#define XRTG_SEED_FILE   "/usr/X/lib/xdm/Xrtg-seed"
+#define XRTG_SEED_NEW    "/usr/X/lib/xdm/Xrtg-seed.new"
+#define XRTG_SEED_LEN    32
+
+typedef unsigned long XrtgU32;
+
+typedef struct {
+    XrtgU32 h[8];
+    XrtgU32 bytes;
+    unsigned int used;
+    unsigned char block[64];
+} XrtgSha256;
+
+static XrtgU32 xrtg_k[64] = {
+    0x428a2f98UL, 0x71374491UL, 0xb5c0fbcfUL, 0xe9b5dba5UL,
+    0x3956c25bUL, 0x59f111f1UL, 0x923f82a4UL, 0xab1c5ed5UL,
+    0xd807aa98UL, 0x12835b01UL, 0x243185beUL, 0x550c7dc3UL,
+    0x72be5d74UL, 0x80deb1feUL, 0x9bdc06a7UL, 0xc19bf174UL,
+    0xe49b69c1UL, 0xefbe4786UL, 0x0fc19dc6UL, 0x240ca1ccUL,
+    0x2de92c6fUL, 0x4a7484aaUL, 0x5cb0a9dcUL, 0x76f988daUL,
+    0x983e5152UL, 0xa831c66dUL, 0xb00327c8UL, 0xbf597fc7UL,
+    0xc6e00bf3UL, 0xd5a79147UL, 0x06ca6351UL, 0x14292967UL,
+    0x27b70a85UL, 0x2e1b2138UL, 0x4d2c6dfcUL, 0x53380d13UL,
+    0x650a7354UL, 0x766a0abbUL, 0x81c2c92eUL, 0x92722c85UL,
+    0xa2bfe8a1UL, 0xa81a664bUL, 0xc24b8b70UL, 0xc76c51a3UL,
+    0xd192e819UL, 0xd6990624UL, 0xf40e3585UL, 0x106aa070UL,
+    0x19a4c116UL, 0x1e376c08UL, 0x2748774cUL, 0x34b0bcb5UL,
+    0x391c0cb3UL, 0x4ed8aa4aUL, 0x5b9cca4fUL, 0x682e6ff3UL,
+    0x748f82eeUL, 0x78a5636fUL, 0x84c87814UL, 0x8cc70208UL,
+    0x90befffaUL, 0xa4506cebUL, 0xbef9a3f7UL, 0xc67178f2UL
+};
+
+#define XRTG_ROR(x,n) (((x) >> (n)) | ((x) << (32 - (n))))
+#define XRTG_CH(x,y,z) (((x) & (y)) ^ (~(x) & (z)))
+#define XRTG_MAJ(x,y,z) (((x) & (y)) ^ ((x) & (z)) ^ ((y) & (z)))
+#define XRTG_BS0(x) (XRTG_ROR((x),2) ^ XRTG_ROR((x),13) ^ XRTG_ROR((x),22))
+#define XRTG_BS1(x) (XRTG_ROR((x),6) ^ XRTG_ROR((x),11) ^ XRTG_ROR((x),25))
+#define XRTG_SS0(x) (XRTG_ROR((x),7) ^ XRTG_ROR((x),18) ^ ((x) >> 3))
+#define XRTG_SS1(x) (XRTG_ROR((x),17) ^ XRTG_ROR((x),19) ^ ((x) >> 10))
+
+static void
+XrtgShaTransform (c, p)
+    XrtgSha256 *c;
+    unsigned char *p;
+{
+    XrtgU32 w[64];
+    XrtgU32 a, b, cc, d, e, f, g, h, t1, t2;
+    int i;
+
+    for (i = 0; i < 16; i++) {
+	w[i] = ((XrtgU32) p[i * 4] << 24) |
+	       ((XrtgU32) p[i * 4 + 1] << 16) |
+	       ((XrtgU32) p[i * 4 + 2] << 8) |
+	       (XrtgU32) p[i * 4 + 3];
+    }
+    for (i = 16; i < 64; i++)
+	w[i] = XRTG_SS1(w[i - 2]) + w[i - 7] +
+	       XRTG_SS0(w[i - 15]) + w[i - 16];
+
+    a = c->h[0]; b = c->h[1]; cc = c->h[2]; d = c->h[3];
+    e = c->h[4]; f = c->h[5]; g = c->h[6]; h = c->h[7];
+    for (i = 0; i < 64; i++) {
+	t1 = h + XRTG_BS1(e) + XRTG_CH(e, f, g) + xrtg_k[i] + w[i];
+	t2 = XRTG_BS0(a) + XRTG_MAJ(a, b, cc);
+	h = g; g = f; f = e; e = d + t1;
+	d = cc; cc = b; b = a; a = t1 + t2;
+    }
+    c->h[0] += a; c->h[1] += b; c->h[2] += cc; c->h[3] += d;
+    c->h[4] += e; c->h[5] += f; c->h[6] += g; c->h[7] += h;
+}
+
+static void
+XrtgShaInit (c)
+    XrtgSha256 *c;
+{
+    c->h[0] = 0x6a09e667UL; c->h[1] = 0xbb67ae85UL;
+    c->h[2] = 0x3c6ef372UL; c->h[3] = 0xa54ff53aUL;
+    c->h[4] = 0x510e527fUL; c->h[5] = 0x9b05688cUL;
+    c->h[6] = 0x1f83d9abUL; c->h[7] = 0x5be0cd19UL;
+    c->bytes = 0;
+    c->used = 0;
+}
+
+static void
+XrtgShaUpdate (c, p, len)
+    XrtgSha256 *c;
+    unsigned char *p;
+    unsigned int len;
+{
+    unsigned int take, i;
+
+    c->bytes += len;
+    while (len) {
+	take = 64 - c->used;
+	if (take > len)
+	    take = len;
+	for (i = 0; i < take; i++)
+	    c->block[c->used + i] = p[i];
+	c->used += take;
+	p += take;
+	len -= take;
+	if (c->used == 64) {
+	    XrtgShaTransform (c, c->block);
+	    c->used = 0;
+	}
+    }
+}
+
+static void
+XrtgShaFinal (c, out)
+    XrtgSha256 *c;
+    unsigned char out[32];
+{
+    unsigned char pad[64], length[8];
+    XrtgU32 hi, lo;
+    unsigned int padlen, i;
+
+    for (i = 0; i < sizeof (pad); i++)
+	pad[i] = 0;
+    pad[0] = 0x80;
+    hi = c->bytes >> 29;
+    lo = c->bytes << 3;
+    length[0] = (hi >> 24) & 0xff; length[1] = (hi >> 16) & 0xff;
+    length[2] = (hi >> 8) & 0xff;  length[3] = hi & 0xff;
+    length[4] = (lo >> 24) & 0xff; length[5] = (lo >> 16) & 0xff;
+    length[6] = (lo >> 8) & 0xff;  length[7] = lo & 0xff;
+    padlen = c->used < 56 ? 56 - c->used : 120 - c->used;
+    XrtgShaUpdate (c, pad, padlen);
+    XrtgShaUpdate (c, length, 8);
+    for (i = 0; i < 8; i++) {
+	out[i * 4] = (c->h[i] >> 24) & 0xff;
+	out[i * 4 + 1] = (c->h[i] >> 16) & 0xff;
+	out[i * 4 + 2] = (c->h[i] >> 8) & 0xff;
+	out[i * 4 + 3] = c->h[i] & 0xff;
+    }
+}
+
+static int
+XrtgReadSeed (seed)
+    unsigned char seed[XRTG_SEED_LEN];
+{
+    FILE *f;
+    struct stat st;
+    int extra;
+
+    if (stat (XRTG_SEED_FILE, &st) != 0 || st.st_uid != 0 ||
+	(st.st_mode & 077) != 0)
+	return 0;
+    f = fopen (XRTG_SEED_FILE, "r");
+    if (!f)
+	return 0;
+    if (fread ((char *) seed, 1, XRTG_SEED_LEN, f) != XRTG_SEED_LEN) {
+	fclose (f);
+	return 0;
+    }
+    extra = fgetc (f);
+    fclose (f);
+    return extra == EOF;
+}
+
+static int
+XrtgWriteSeed (seed)
+    unsigned char seed[XRTG_SEED_LEN];
+{
+    FILE *f;
+    int mask, ok;
+
+    mask = umask (0077);
+    (void) unlink (XRTG_SEED_NEW);
+    f = fopen (XRTG_SEED_NEW, "w");
+    (void) umask (mask);
+    if (!f)
+	return 0;
+    ok = fwrite ((char *) seed, 1, XRTG_SEED_LEN, f) == XRTG_SEED_LEN;
+    if (fclose (f) == EOF)
+	ok = 0;
+    if (ok)
+	(void) chmod (XRTG_SEED_NEW, 0600);
+    if (!ok || rename (XRTG_SEED_NEW, XRTG_SEED_FILE) != 0) {
+	(void) unlink (XRTG_SEED_NEW);
+	return 0;
+    }
+    return 1;
+}
+
+static unsigned long xrtg_sequence;
+
+static void
+XrtgGenerateAuthorization (auth, len, ldata)
+    char *auth;
+    int len;
+    long ldata[2];
+{
+    XrtgSha256 c;
+    unsigned char seed[XRTG_SEED_LEN], next[XRTG_SEED_LEN];
+    unsigned char digest[32];
+    unsigned long pid, ppid, sequence;
+    int have_seed, i;
+    static unsigned char seed_label[] = "Xrtg xdm seed v1";
+    static unsigned char cookie_label[] = "Xrtg xdm cookie v1";
+
+    for (i = 0; i < XRTG_SEED_LEN; i++)
+	seed[i] = 0;
+    have_seed = XrtgReadSeed (seed);
+    pid = (unsigned long) getpid ();
+    ppid = (unsigned long) getppid ();
+    sequence = ++xrtg_sequence;
+
+    XrtgShaInit (&c);
+    XrtgShaUpdate (&c, seed_label, sizeof (seed_label) - 1);
+    XrtgShaUpdate (&c, seed, sizeof (seed));
+    XrtgShaUpdate (&c, (unsigned char *) ldata, sizeof (long) * 2);
+    XrtgShaUpdate (&c, (unsigned char *) &pid, sizeof (pid));
+    XrtgShaUpdate (&c, (unsigned char *) &ppid, sizeof (ppid));
+    XrtgShaUpdate (&c, (unsigned char *) &sequence, sizeof (sequence));
+    XrtgShaFinal (&c, next);
+
+    XrtgShaInit (&c);
+    XrtgShaUpdate (&c, cookie_label, sizeof (cookie_label) - 1);
+    XrtgShaUpdate (&c, next, sizeof (next));
+    XrtgShaUpdate (&c, seed, sizeof (seed));
+    XrtgShaUpdate (&c, (unsigned char *) ldata, sizeof (long) * 2);
+    XrtgShaFinal (&c, digest);
+
+    for (i = 0; i < len; i++)
+	auth[i] = digest[i & 31];
+
+    if (!have_seed)
+	LogError (XRTG_AUTH_MARKER ": missing or unsafe " XRTG_SEED_FILE
+		  "; cookie uses emergency fallback\n");
+    else if (!XrtgWriteSeed (next))
+	LogError (XRTG_AUTH_MARKER ": cannot advance " XRTG_SEED_FILE "\n");
+
+    for (i = 0; i < XRTG_SEED_LEN; i++) {
+	seed[i] = 0;
+	next[i] = 0;
+	digest[i] = 0;
+    }
+}
+
+#endif /* !HASXDMAUTH */
+
