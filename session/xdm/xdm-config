! Xdm configuration for the local Xrtg display on AMIX.
!
! daemonMode must remain false when xdm is supervised by the AMIX SAF port
! monitor.  UDP port 177 avoids the broken no-socket SAF polling path in this
! X11R5 port; Xaccess-local contains no allowed XDMCP hosts.

DisplayManager.servers:          /usr/lib/X11/xdm/Xservers
DisplayManager.errorLogFile:     /usr/lib/X11/xdm/xdm-errors
DisplayManager.pidFile:          /usr/lib/X11/xdm/xdm-pid
DisplayManager.daemonMode:       false
DisplayManager.debugLevel:       0

DisplayManager.requestPort:      177
DisplayManager.accessFile:       /usr/lib/X11/xdm/Xaccess-local

DisplayManager._0.resources:     /usr/lib/X11/xdm/Xresources
DisplayManager._0.setup:         /usr/lib/X11/xdm/Xsetup_0
DisplayManager._0.session:       /usr/X/lib/xrtg/xrtg-session
DisplayManager._0.grabServer:    false

DisplayManager._0.authorize:     true
DisplayManager._0.authName:      MIT-MAGIC-COOKIE-1
DisplayManager._0.authFile:      /usr/X/lib/xdm/Xrtg-auth
DisplayManager*authorize:        false
